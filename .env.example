# DomusTech — variáveis de ambiente (exemplo)
# Copia para .env e preenche. O .env real NUNCA entra no git.
#
# O site atual não exige nenhuma variável para correr localmente.
# As entradas abaixo são placeholders para quando forem precisas.

# Ambiente de execução (development | production)
NODE_ENV=development

# --- PÚBLICAS (prefixo VITE_, expostas ao browser — nunca segredos) ---
# ID de analytics, URLs públicas, etc.
# VITE_GA_ID=
# VITE_SITE_URL=https://domustech.lovable.app

# [DESCONTINUADO] Make.com webhook — substituído por Resend + Google Apps Script abaixo.
VITE_MAKE_WEBHOOK_URL=

# --- SANITY CMS (PÚBLICO — prefixo VITE_, safe no browser) ---
# Criar projeto em sanity.io/manage
VITE_SANITY_PROJECT_ID=zlzgp38h
VITE_SANITY_DATASET=production

# --- SANITY WRITE TOKEN (servidor/seed apenas — NUNCA com prefixo VITE_) ---
# Usado só no script de seed: node scripts/seed-sanity.mjs
# Gerar em sanity.io/manage → API → Tokens → Add API token (Editor)
SANITY_TOKEN=

# --- SERVIDOR (sem prefixo VITE_, só server-side — segredos OK) ---
# Lidas em src/lib/config.server.ts
# DATABASE_URL=
# STRIPE_SECRET_KEY=

# --- LEADS: form "Agendar Consulta" (ConsultaModal.tsx → src/lib/api/consulta.functions.ts) ---
# Resend (resend.com) — API Keys → Create API Key
RESEND_API_KEY=
# Precisa de domínio verificado no Resend (Domains → Add Domain, esdomustech.com).
# Sem isso, deixar vazio usa o remetente de teste onboarding@resend.dev (só chega ao dono da conta Resend).
RESEND_FROM_EMAIL="EsDomusTech <leads@esdomustech.com>"
RESEND_TO_EMAIL=marketing@esdomustech.com
# Google Apps Script Web App URL — ver scripts/google-sheets-leads.gs para o script + passos de deploy
GOOGLE_SHEETS_WEBHOOK_URL=
